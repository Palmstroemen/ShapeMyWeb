{
  "name": "shapemyweb",
  "version": "0.4.0",
  "private": true,
  "description": "Browser-Extension für eine persönliche Blacklist: Webseiten bewusst vermeiden.",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/chromium.smoke.js && node test/e2e/firefox.smoke.js",
    "test:e2e:chromium": "node test/e2e/chromium.smoke.js",
    "test:e2e:firefox": "node test/e2e/firefox.smoke.js",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start:firefox": "web-ext run --source-dir extension",
    "start:chrome": "web-ext run --source-dir extension --target chromium",
    "store-assets": "node scripts/store-assets.js"
  },
  "devDependencies": {
    "web-ext": "^8.3.0",
    "puppeteer-core": "^24.43.1"
  }
}
